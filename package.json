{
  "name": "unimailer",
  "version": "2.2.0",
  "description": "Modern, multi-runtime email library for Node.js, Bun, Deno, and Edge. SMTP + HTTP providers with automatic failover, retry logic, DKIM signing, and MIME encoding.",
  "author": "bazil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BazilSuhail/unimailer"
  },
  "keywords": [
    "email",
    "mailer",
    "nodemailer",
    "smtp",
    "resend",
    "sendgrid",
    "postmark",
    "transactional-email",
    "email-library",
    "email-sending",
    "mime",
    "multipart",
    "email-transport",
    "typescript",
    "ts",
    "failover",
    "retry",
    "email-api",
    "email-service",
    "bulk-email",
    "email-queue",
    "html-email",
    "email-attachments",
    "dkim",
    "oauth2",
    "bun",
    "deno",
    "nodejs",
    "edge",
    "serverless",
    "react-email",
    "email-validation",
    "provider",
    "multi-provider",
    "resend-api",
    "sendgrid",
    "mailgun",
    "aws-ses",
    "cloudflare-workers",
    "vercel-edge"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./smtp": {
      "import": {
        "types": "./dist/providers/smtp/index.d.ts",
        "default": "./dist/providers/smtp/index.js"
      },
      "require": {
        "types": "./dist/providers/smtp/index.d.cts",
        "default": "./dist/providers/smtp/index.cjs"
      }
    },
    "./resend": {
      "import": {
        "types": "./dist/providers/resend/index.d.ts",
        "default": "./dist/providers/resend/index.js"
      },
      "require": {
        "types": "./dist/providers/resend/index.d.cts",
        "default": "./dist/providers/resend/index.cjs"
      }
    },
    "./sendgrid": {
      "import": {
        "types": "./dist/providers/sendgrid/index.d.ts",
        "default": "./dist/providers/sendgrid/index.js"
      },
      "require": {
        "types": "./dist/providers/sendgrid/index.d.cts",
        "default": "./dist/providers/sendgrid/index.cjs"
      }
    },
    "./postmark": {
      "import": {
        "types": "./dist/providers/postmark/index.d.ts",
        "default": "./dist/providers/postmark/index.js"
      },
      "require": {
        "types": "./dist/providers/postmark/index.d.cts",
        "default": "./dist/providers/postmark/index.cjs"
      }
    },
    "./ses": {
      "import": {
        "types": "./dist/providers/ses/index.d.ts",
        "default": "./dist/providers/ses/index.js"
      },
      "require": {
        "types": "./dist/providers/ses/index.d.cts",
        "default": "./dist/providers/ses/index.cjs"
      }
    },
    "./mailgun": {
      "import": {
        "types": "./dist/providers/mailgun/index.d.ts",
        "default": "./dist/providers/mailgun/index.js"
      },
      "require": {
        "types": "./dist/providers/mailgun/index.d.cts",
        "default": "./dist/providers/mailgun/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.79.0",
    "tsup": "^8.4.0",
    "typescript": "~5.7.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/BazilSuhail"
  }
}
